# ============================================================================
# Rattle-Snake V2 — environment template
# Copy to .env and adjust. All keys are optional; sane defaults are shown.
# ============================================================================

# --- API (apps/api) ---------------------------------------------------------
API_PORT=8787

# LLM provider (see docs/architecture.md §11 for the full table):
#   openai | anthropic | google | deepseek | kimi | grok | groq | qwen
#   | openrouter | ollama | vllm | lmstudio | localai | custom | mock
#   mock  = offline canned responses, used for tests / trying the pipeline
#   custom or any UNKNOWN name = generic OpenAI-compatible endpoint
LLM_PROVIDER=openai

# Optional overrides. When unset, the provider preset supplies defaults and the
# provider's standard key env var is consulted (OPENAI_API_KEY,
# ANTHROPIC_API_KEY, GEMINI_API_KEY, DEEPSEEK_API_KEY, MOONSHOT_API_KEY,
# XAI_API_KEY, GROQ_API_KEY, DASHSCOPE_API_KEY, OPENROUTER_API_KEY).
#
#   OpenAI:   provider=openai     model=gpt-4o-mini
#   Anthropic:provider=anthropic  model=claude-sonnet-4-5
#   Google:   provider=google     model=gemini-2.5-flash
#   DeepSeek: provider=deepseek   model=deepseek-chat
#   Kimi:     provider=kimi       model=kimi-k2-0905-preview
#   Grok:     provider=grok       model=grok-3-mini
#   Groq:     provider=groq       model=llama-3.3-70b-versatile
#   Qwen:     provider=qwen       model=qwen-plus
#   OpenRouter:provider=openrouter model=openai/gpt-4o-mini
#   Ollama:   provider=ollama     base http://localhost:11434/v1 model llama3.1
#   vLLM:     provider=vllm       base http://localhost:8000/v1  model REQUIRED
#   Custom:   provider=custom     base REQUIRED, model REQUIRED
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Debate tuning
LLM_TEMPERATURE=0.3
DEBATE_CROSS_TALK_ROUNDS=2
AGENT_MAX_RETRIES=2

# Where SQLite state lives
DATABASE_PATH=./data/rattle-snake.db

# Comma-separated list of allowed browser origins for CORS
# (empty = allow all — fine for localhost self-hosting)
CORS_ORIGINS=

# --- Web (apps/web) ---------------------------------------------------------
# Public base URL of the API as reachable from the browser
PUBLIC_API_URL=http://localhost:8787
