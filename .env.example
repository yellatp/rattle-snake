# ============================================================================
# Rattle-Snake V2 — environment template
# Copy to .env and adjust. All keys are optional; sane defaults are shown.
# ============================================================================

# --- API (apps/api) ---------------------------------------------------------
API_PORT=8787

# LLM provider: "openai" | "mock"
#   openai = any OpenAI-compatible endpoint (Ollama, vLLM, LocalAI, llama.cpp, ...)
#   mock   = offline canned responses, used for tests / trying the pipeline
LLM_PROVIDER=openai

# OpenAI-compatible endpoint + model
#   Ollama:  baseURL http://localhost:11434/v1   model llama3.1
#   vLLM:    baseURL http://localhost:8000/v1     model your-deployed-model
#   LocalAI: baseURL http://localhost:8080/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

# Debate tuning
LLM_TEMPERATURE=0.3
DEBATE_CROSS_TALK_ROUNDS=2
AGENT_MAX_RETRIES=2

# Where SQLite state lives
DATABASE_PATH=./data/rattle-snake.db

# Comma-separated list of allowed browser origins for CORS
# (empty = allow all — fine for localhost self-hosting)
CORS_ORIGINS=

# --- Web (apps/web) ---------------------------------------------------------
# Public base URL of the API as reachable from the browser
PUBLIC_API_URL=http://localhost:8787
