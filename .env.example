# ============================================================================
# Rattle-Snake V2 — environment template
# Copy to .env and adjust. All keys are optional; sane defaults are shown.
# ============================================================================

# --- API (apps/api) ---------------------------------------------------------
API_PORT=8787

# LLM provider (see docs/architecture.md §11 for the full table):
#   openai | anthropic | google | deepseek | kimi | grok | groq | qwen
#   | openrouter | ollama | vllm | lmstudio | localai | custom | mock
#   mock  = offline canned responses, used for tests / trying the pipeline
#   custom or any UNKNOWN name = generic OpenAI-compatible endpoint
#   Default (unset) = mock, so the stack runs with zero configuration.
LLM_PROVIDER=mock

# Optional overrides. When unset, the provider preset supplies defaults and the
# provider's standard key env var is consulted (OPENAI_API_KEY,
# ANTHROPIC_API_KEY, GEMINI_API_KEY, DEEPSEEK_API_KEY, MOONSHOT_API_KEY,
# XAI_API_KEY, GROQ_API_KEY, DASHSCOPE_API_KEY, OPENROUTER_API_KEY).
#
# NOTE: users can also bring their own key/endpoint PER RUN from the web UI
# (New Debate -> "Bring your own LLM API") or via POST /api/jobs { llm: {...} };
# the key is used in-memory only and never stored.
#
#   OpenAI:   provider=openai     model=gpt-4o-mini
#   Anthropic:provider=anthropic  model=claude-sonnet-4-5
#   Google:   provider=google     model=gemini-2.5-flash
#   DeepSeek: provider=deepseek   model=deepseek-chat
#   Kimi:     provider=kimi       model=kimi-k2-0905-preview
#   Grok:     provider=grok       model=grok-3-mini
#   Groq:     provider=groq       model=llama-3.3-70b-versatile
#   Qwen:     provider=qwen       model=qwen-plus
#   OpenRouter:provider=openrouter model=openai/gpt-4o-mini
#   Ollama:   provider=ollama     base http://localhost:11434/v1 model llama3.1
#   vLLM:     provider=vllm       base http://localhost:8000/v1  model REQUIRED
#   Custom:   provider=custom     base REQUIRED, model REQUIRED
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Debate tuning
LLM_TEMPERATURE=0.3
DEBATE_CROSS_TALK_ROUNDS=2
AGENT_MAX_RETRIES=2

# Where SQLite state lives
DATABASE_PATH=./data/rattle-snake.db

# The API auto-creates ./data/.secret (0600) on first start: the master key used
# to encrypt LLM API keys stored from the Settings page. Back it up with the
# database. Users can also save named LLM connections in Settings
# (/settings) instead of editing this file — those keys are encrypted at rest
# and never returned to the browser.

# Comma-separated list of allowed browser origins for CORS
# (empty = allow all — fine for localhost self-hosting)
CORS_ORIGINS=

# --- Security (SaaS / multi-tenant deployments) ------------------------------
# Require the X-API-Key header on every request. Unset, this defaults to ON
# when NODE_ENV=production and OFF otherwise. Configure keys via API_KEYS.
# REQUIRE_API_KEY=true

# API keys as JSON: { "<key>": { "tenantId": "acme", "keyId": "key-1" } }.
# Or set API_KEYS_FILE to a JSON file path (file wins when both are set).
# API_KEYS={"sk-live-...":{"tenantId":"acme","keyId":"key-1"}}

# Trust X-Forwarded-For / X-Real-IP for client IP detection (rate limiting,
# audit). Enable ONLY when running behind a trusted reverse proxy / load balancer.
# TRUST_PROXY=false

# Rate limiting (requests per window per tenant+key+IP). 0 disables.
# Defaults: 60/min in production, disabled (0) in development/test.
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_MS=60000

# Max accepted request body size in bytes.
# MAX_BODY_SIZE_BYTES=262144

# --- Queue & events (horizontal scaling) -------------------------------------
# Redis turns the in-process queue/event bus into shared infrastructure so the
# API can scale to N instances + N workers. Unset = in-process (single node).
# REDIS_URL=redis://localhost:6379
# QUEUE_CONCURRENCY=4

# --- Audit log ----------------------------------------------------------------
# Log level for the structured (pino) audit log. AUDIT_PRETTY=false for JSON
# lines (recommended when shipping to a log collector).
# AUDIT_LOG_LEVEL=info
# AUDIT_PRETTY=false

# --- Web (apps/web) ---------------------------------------------------------
# Public base URL of the API as reachable from the browser
PUBLIC_API_URL=http://localhost:8787
