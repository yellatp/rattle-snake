---
import "../styles/global.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;

const NAV = [
  { href: "/dashboard", label: "Dashboard", short: "Dashboard" },
  { href: "/sme-panel", label: "New Run", short: "New Run" },
  { href: "/storage", label: "Runs", short: "Runs" },
  { href: "/profile", label: "Profiles", short: "Profiles" },
  { href: "/settings", label: "Settings", short: "Settings" },
  { href: "/help", label: "Help", short: "Help" },
];

function isActive(href: string): boolean {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href + "/");
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/rattle-snake.png" />
    <link rel="alternate icon" href="/rattle-snake.png" />
    <title>{title} · Rattle Snake</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/dashboard">
          <img class="brand-logo" src="/rattle-snake.png" alt="Rattle Snake" />
          <span class="brand-name">Rattle Snake</span>
        </a>
        <nav class="side-nav">
          {
            NAV.map((item) => (
              <a
                class:list={["side-link", { active: isActive(item.href) }]}
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                <span class="side-link-short">{item.short}</span>
              </a>
            ))
          }
        </nav>
      </aside>
      <main class="site-main">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>
          Rattle Snake · <a href="/help">Help</a>
        </span>
        <span class="footer-built">
          <span>Built in association with</span>
          <a class="footer-logo-link" href="https://alphonso.app" target="_blank" rel="noopener noreferrer">
            <img class="footer-logo alphonso" src="/Alphonso.svg" alt="Alphonso AI" />
          </a>
          <a class="footer-logo-link" href="https://onlynerds.win" target="_blank" rel="noopener noreferrer">
            <img class="footer-logo onlynerds" src="/OnlyNerds_Nav.svg" alt="OnlyNerds" />
          </a>
          <span>Built by PYE (Co-Founder of Alphonso AI)</span>
        </span>
      </div>
    </footer>
  </body>
</html>
