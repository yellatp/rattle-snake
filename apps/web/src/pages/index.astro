---
import Layout from "../layouts/Layout.astro";
import NewJobForm from "../components/NewJobForm.tsx";
---
<Layout title="New Debate">
  <section class="hero">
    <h1>Run a hiring committee debate</h1>
    <p class="lead">
      Paste a job description and a resume. Five named domain experts —
      Recruiter, Technical Specialist, Team Lead, Hiring Manager and a Sector
      Specialist — debate the candidate in three rounds, then are forced to a
      non-neutral verdict. The objections they raise drive an automatic resume
      rewrite.
    </p>
    <div class="domain-strip">
      <span class="tag">SWE Committee</span>
      <span class="tag">Data &amp; AI Committee</span>
      <span class="tag">Finance &amp; Banking Committee</span>
      <span class="tag sector">+ Sector Specialist seat</span>
    </div>
  </section>

  <NewJobForm client:load />

  <section class="how">
    <h2>How a run works</h2>
    <ol>
      <li><strong>Round 1 — Opening Arguments.</strong> Each of the 5 personas gives an initial assessment, explicitly listing <em>top 2 hire reasons</em> and <em>top 2 reject reasons</em>, then ends with <span class="mono">[STRONG HIRE]</span> or <span class="mono">[STRONG REJECT]</span>.</li>
      <li><strong>Round 2+ — Committee Cross-talk.</strong> Agents respond to each other by name. The Sector Specialist audits industry fit and cross-sector transferable skills.</li>
      <li><strong>Round 3 — Final Ballot.</strong> Each agent casts a decisive final vote. Weighted consensus decides <em>SHORTLISTED</em> or <em>REJECTED</em>.</li>
      <li><strong>Resume Rewrite.</strong> The committee blueprint is converted into a rewritten resume that resolves every raised objection.</li>
    </ol>
  </section>
</Layout>

<style>
  .hero h1 {
    font-size: 34px;
    margin: 0 0 10px;
  }
  .lead {
    color: var(--text-dim);
    max-width: 760px;
    margin: 0 0 18px;
  }
  .domain-strip {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .how {
    margin-top: 48px;
    color: var(--text-dim);
  }
  .how h2 {
    color: var(--text);
    font-size: 20px;
  }
  .how ol {
    max-width: 820px;
    padding-left: 20px;
  }
  .how li {
    margin-bottom: 10px;
  }
  .how strong {
    color: var(--text);
  }
</style>
