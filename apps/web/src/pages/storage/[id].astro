---
import Layout from "../../layouts/Layout.astro";
import StorageViewer from "../../components/StorageViewer.tsx";

const { id } = Astro.params;
const tab = Astro.url.searchParams.get("tab") ?? undefined;
---
<Layout title="Stored Result">
  <div id="storage-viewer-app">
    {id ? (
      <StorageViewer client:load jobId={id} initialTab={tab} />
    ) : (
      <section class="panel">
        <h2>Result not found</h2>
        <p class="hint"><a href="/storage">Back to storage</a></p>
      </section>
    )}
  </div>
</Layout>
